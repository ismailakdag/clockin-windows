<Window x:Class="Clockin.Windows.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clockin Settings" Width="520" Height="760" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <ScrollViewer Padding="18"><StackPanel>
    <TextBlock Text="Settings are saved automatically." FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16"/>
    <TextBlock Text="PAY &amp; CURRENCY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><StackPanel>
      <DockPanel LastChildFill="False"><TextBlock Text="Hourly rate" VerticalAlignment="Center"/><TextBox x:Name="RateBox" Width="120" DockPanel.Dock="Right"/></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Currency" VerticalAlignment="Center"/><ComboBox x:Name="CurrencyBox" Width="120" DockPanel.Dock="Right"><ComboBoxItem Content="USD"/><ComboBoxItem Content="EUR"/><ComboBoxItem Content="GBP"/><ComboBoxItem Content="TRY"/></ComboBox></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><StackPanel><TextBlock Text="RATE SCHEDULE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="Effective-date rates recalculate old sessions correctly." FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="Manage" DockPanel.Dock="Right" Click="RateSchedule_Click"/></DockPanel>
      <Button Content="Apply pay settings" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Apply_Click"/>
    </StackPanel></Border>
    <TextBlock Text="EARNINGS GOALS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><StackPanel>
      <DockPanel LastChildFill="False"><TextBlock Text="Daily hours"/><TextBox x:Name="DailyGoal" Width="120" DockPanel.Dock="Right"/></DockPanel><DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Monthly hours"/><TextBox x:Name="MonthlyGoal" Width="120" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="Goals are measured in worked hours and update live while clocked in." FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,9,0,0"/><Button Content="Apply goals" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Apply_Click"/>
    </StackPanel></Border>
    <TextBlock Text="APPEARANCE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><StackPanel>
      <DockPanel LastChildFill="False"><TextBlock Text="Theme &amp; font" VerticalAlignment="Center"/><ComboBox x:Name="ThemeBox" Width="180" DockPanel.Dock="Right"><ComboBoxItem Content="Carbon"/><ComboBoxItem Content="Neon Orange"/><ComboBoxItem Content="Electric Blue"/><ComboBoxItem Content="Synthwave"/><ComboBoxItem Content="Data Dense"/><ComboBoxItem Content="Aurora"/><ComboBoxItem Content="Terminal Amber"/><ComboBoxItem Content="Daylight"/></ComboBox></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Pinned widget mode" VerticalAlignment="Center"/><ComboBox x:Name="PinnedModeBox" Width="130" DockPanel.Dock="Right"><ComboBoxItem Content="Compact"/><ComboBoxItem Content="Money"/><ComboBoxItem Content="Goal"/><ComboBoxItem Content="All"/></ComboBox></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Pinned widget"/><CheckBox x:Name="PinEnabled" Content="Show" DockPanel.Dock="Right"/></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Progress mascot"/><CheckBox x:Name="MascotEnabled" Content="Enabled" DockPanel.Dock="Right"/></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Mascot default"/><ComboBox x:Name="MascotDefaultBox" Width="150" DockPanel.Dock="Right"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Typing"/><ComboBoxItem Content="Coffee"/><ComboBoxItem Content="Victory"/><ComboBoxItem Content="Stretch"/><ComboBoxItem Content="Dance"/><ComboBoxItem Content="Music"/></ComboBox></DockPanel>
      <DockPanel LastChildFill="False" Margin="0,9,0,0"><StackPanel><TextBlock Text="TRAY-ONLY MODE" FontSize="9" FontWeight="Bold"/><TextBlock Text="Hide the main window and keep controls in the bottom-right Windows tray." FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><CheckBox x:Name="MinimalMode" Content="On" DockPanel.Dock="Right"/></DockPanel>
      <WrapPanel Margin="0,9,0,0"><CheckBox x:Name="MinimalShowHours" Content="Hours"/><CheckBox x:Name="MinimalShowEarnings" Content="Earnings"/><CheckBox x:Name="MinimalShowTRY" Content="TRY"/><CheckBox x:Name="MinimalShowGoal" Content="Goal %"/></WrapPanel>
      <Button Content="Apply appearance" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Apply_Click"/>
    </StackPanel></Border>
    <TextBlock Text="FOCUS CHIME" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><StackPanel>
      <DockPanel LastChildFill="False"><TextBlock Text="Enable focus chime"/><CheckBox x:Name="ChimeEnabled" Content="On" DockPanel.Dock="Right"/></DockPanel><DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Interval (1–120 minutes)"/><TextBox x:Name="ChimeInterval" Width="120" DockPanel.Dock="Right"/></DockPanel><DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Sound"/><ComboBox x:Name="ChimeSound" Width="150" DockPanel.Dock="Right"/></DockPanel><DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Volume"/><Slider x:Name="ChimeVolume" Width="150" Minimum="0.1" Maximum="1" DockPanel.Dock="Right"/></DockPanel><Button Content="Preview selected sound" HorizontalAlignment="Right" Margin="0,10,0,0" Click="Preview_Click"/>
    </StackPanel></Border>
    <TextBlock Text="KEYBOARD SHORTCUTS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><StackPanel><TextBlock Text="Ctrl+Alt+I   Clock in / resume" FontFamily="Cascadia Mono" FontSize="10"/><TextBlock Text="Ctrl+Alt+P   Pause / resume" FontFamily="Cascadia Mono" FontSize="10" Margin="0,6,0,0"/><TextBlock Text="Ctrl+Alt+O   Clock out" FontFamily="Cascadia Mono" FontSize="10" Margin="0,6,0,0"/><TextBlock Text="Ctrl+Alt+E   Open Clockin" FontFamily="Cascadia Mono" FontSize="10" Margin="0,6,0,0"/></StackPanel></Border>
    <TextBlock Text="FOCUS RADIO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><StackPanel><DockPanel LastChildFill="False"><TextBlock Text="Station" VerticalAlignment="Center"/><ComboBox x:Name="StationBox" Width="180" DockPanel.Dock="Right"><ComboBoxItem Content="[EN] Radio Paradise"/></ComboBox></DockPanel><DockPanel LastChildFill="False" Margin="0,9,0,0"><TextBlock Text="Volume"/><Slider x:Name="RadioVolume" Width="180" Minimum="0" Maximum="1" DockPanel.Dock="Right"/></DockPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0"><Button x:Name="RadioButton" Content="Play" Click="Radio_Click"/><Button Content="Stop" Click="RadioStop_Click"/></StackPanel><TextBlock Text="Eclectic, listener-supported, commercial-free · streams over the internet." FontSize="9" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
    <TextBlock Text="DATA" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,7"/>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="12"><WrapPanel><Button Content="Import CSV" Click="ImportCsv_Click"/><Button Content="Paste timecards" Click="Paste_Click"/><Button Content="Clear latest entry" Click="ClearLatest_Click"/><Button Content="Delete all" Foreground="#FFE07A78" Click="DeleteAll_Click"/><Button Content="Export backup" Click="Export_Click"/><Button Content="Restore file" Click="Import_Click"/><Button Content="Restore latest" Click="Restore_Click"/><Button Content="Open data folder" Click="OpenData_Click"/></WrapPanel></Border>
    <TextBlock x:Name="Status" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </StackPanel></ScrollViewer>
</Window>
