<Window x:Class="Clockin.Windows.PasteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Paste approved timecards" Width="620" Height="470" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Paste the copied approved timecard page below." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/><Button Content="Paste from clipboard" DockPanel.Dock="Right" Click="Paste_Click"/></DockPanel><TextBox x:Name="PasteText" Grid.Row="1" AcceptsReturn="True" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" TextWrapping="Wrap" Margin="0,10" TextChanged="Paste_Changed"/><TextBlock x:Name="Summary" Grid.Row="2" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancel" Click="Cancel_Click"/><Button x:Name="PreviewButton" Content="Compare before import" Click="Import_Click" IsDefault="True"/></StackPanel></Grid>
</Window>
