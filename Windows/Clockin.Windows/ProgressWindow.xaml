<Window x:Class="Clockin.Windows.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clockin progress" Width="620" Height="700" MinWidth="560" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <Style x:Key="ProgressTabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
  </Window.Resources>
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,10">
      <TextBlock Text="LEVELS, BADGES &amp; RHYTHM" FontSize="10" FontWeight="Black" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
      <Button x:Name="ShareStatsButton" Content="Share stats" DockPanel.Dock="Right" Click="ShareStats_Click"/>
    </DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,0,12">
      <UniformGrid Columns="5">
        <Button x:Name="OverviewTab" Tag="0" Style="{StaticResource ProgressTabButton}" Content="Overview" Click="Tab_Click"/>
        <Button x:Name="BadgesTab" Tag="1" Style="{StaticResource ProgressTabButton}" Content="Badges" Click="Tab_Click"/>
        <Button x:Name="RecordsTab" Tag="2" Style="{StaticResource ProgressTabButton}" Content="Records" Click="Tab_Click"/>
        <Button x:Name="WeeklyTab" Tag="3" Style="{StaticResource ProgressTabButton}" Content="Weekly" Click="Tab_Click"/>
        <Button x:Name="ReportsTab" Tag="4" Style="{StaticResource ProgressTabButton}" Content="Reports" Click="Tab_Click"/>
      </UniformGrid>
    </Border>
    <ScrollViewer x:Name="ProgressScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="ProgressContent"/>
    </ScrollViewer>
  </Grid>
</Window>
