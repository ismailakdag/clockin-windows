<Window x:Class="Clockin.Windows.ManualStartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Start with elapsed time" Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="#0E1118" Foreground="#E8ECF4" Padding="18">
  <StackPanel Margin="18"><TextBlock Text="Continue a timer from manually entered hours and minutes." TextWrapping="Wrap" Foreground="#9BA7BB" Margin="0,0,0,12"/><StackPanel Orientation="Horizontal"><TextBox x:Name="Hours" Width="90"/><TextBlock Text=" hours" VerticalAlignment="Center" Margin="5,0,15,0"/><TextBox x:Name="Minutes" Width="90"/><TextBlock Text=" minutes" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Start" Click="Start_Click" IsDefault="True"/></StackPanel></StackPanel>
</Window>
