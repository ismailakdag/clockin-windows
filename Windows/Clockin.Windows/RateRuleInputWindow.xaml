<Window x:Class="Clockin.Windows.RateRuleInputWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New rate rule" Width="350" SizeToContent="Height" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}" Padding="16"><StackPanel><TextBlock Text="Effective from (yyyy-mm-dd)"/><TextBox x:Name="FromText" Text="2026-07-01"/><TextBlock Text="Effective until (optional)" Margin="0,8,0,0"/><TextBox x:Name="UntilText"/><TextBlock Text="Hourly rate" Margin="0,8,0,0"/><TextBox x:Name="RateText" Text="25"/><TextBlock x:Name="Error" Foreground="{DynamicResource WarningBrush}" Margin="0,7,0,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Cancel" Click="Cancel_Click"/><Button Content="Add" Click="Add_Click" IsDefault="True"/></StackPanel></StackPanel></Window>
