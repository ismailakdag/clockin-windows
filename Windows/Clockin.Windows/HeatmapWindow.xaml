<Window x:Class="Clockin.Windows.HeatmapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work heatmap" Width="720" Height="650" MinWidth="600" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="WORK RHYTHM" FontSize="11" FontWeight="Black" Foreground="{DynamicResource MutedBrush}"/>
        <TextBlock x:Name="PeriodLabel" Text="All time" FontSize="18" FontWeight="Bold" Margin="0,3,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Right" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" VerticalAlignment="Center">
        <UniformGrid Columns="3">
          <Button x:Name="WeekButton" Tag="Week" Content="Week" Click="Range_Click" Padding="12,7" Background="Transparent" BorderThickness="0"/>
          <Button x:Name="MonthButton" Tag="Month" Content="Month" Click="Range_Click" Padding="12,7" Background="Transparent" BorderThickness="0"/>
          <Button x:Name="AllButton" Tag="All" Content="All" Click="Range_Click" Padding="12,7" Background="Transparent" BorderThickness="0"/>
        </UniformGrid>
      </Border>
    </DockPanel>
    <UniformGrid x:Name="SummaryGrid" Grid.Row="1" Columns="3" Margin="0,0,0,14"/>
    <ScrollViewer x:Name="HeatmapScroll" Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
      <Grid x:Name="HeatmapHost" MinHeight="300"/>
    </ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,13,0,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Less" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
        <UniformGrid x:Name="LegendGrid" Rows="1" Columns="5" Width="104" Height="16" Margin="8,0"/>
        <TextBlock Text="More" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock DockPanel.Dock="Right" Text="Hover a day for details" FontSize="9" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
    </DockPanel>
  </Grid>
</Window>
