<Window x:Class="Clockin.Windows.ShareStatsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Share your stats" Width="520" Height="700" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0"><TextBlock Text="SHARE YOUR STATS" FontSize="16" FontWeight="Black"/><TextBlock Text="A Clockin rewind card for your focus journey" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,10"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,8"><TextBlock Text="Privacy" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/><ComboBox x:Name="VisibilityBox" Width="120" DockPanel.Dock="Right" SelectionChanged="SelectionChanged"><ComboBoxItem Content="Public"/><ComboBoxItem Content="Private"/></ComboBox></DockPanel>
    <DockPanel Grid.Row="2" Margin="0,0,0,10"><Button x:Name="PreviousButton" Content="‹" Width="32" Click="Previous_Click"/><TextBlock x:Name="PageText" Text="PAGE 1 / 3 · OVERVIEW" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextButton" Content="›" Width="32" Click="Next_Click"/><Button x:Name="AllPagesButton" Content="All 3 pages" HorizontalAlignment="Right" Margin="10,0,0,0" Click="AllPages_Click"/></DockPanel>
    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"><Border x:Name="ShareCard" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="20" Padding="22"><StackPanel x:Name="ShareContent"/></Border></ScrollViewer>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Copy" Click="Copy_Click"/><Button Content="Save text" Click="Save_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel>
  </Grid>
</Window>
