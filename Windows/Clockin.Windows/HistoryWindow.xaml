<Window x:Class="Clockin.Windows.HistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Earnings history" Width="720" Height="700" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel LastChildFill="False"><StackPanel><TextBlock Text="EARNINGS HISTORY" FontSize="16" FontWeight="Bold"/><TextBlock Text="Daily rhythm, earnings and imported time" FontSize="9" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><Button Content="Import CSV" DockPanel.Dock="Right" Click="ImportCsv_Click"/></DockPanel>
    <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,12,0,12">
      <UniformGrid Columns="4"><Button x:Name="Range7Button" Tag="7D" Content="7D" Click="Range_Click" Background="Transparent" BorderThickness="0"/><Button x:Name="Range30Button" Tag="30D" Content="30D" Click="Range_Click" Background="Transparent" BorderThickness="0"/><Button x:Name="Range90Button" Tag="3M" Content="3M" Click="Range_Click" Background="Transparent" BorderThickness="0"/><Button x:Name="RangeAllButton" Tag="ALL" Content="ALL" Click="Range_Click" Background="Transparent" BorderThickness="0"/></UniformGrid>
    </Border>
    <ScrollViewer x:Name="HistoryScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryContent"/></ScrollViewer>
    <DockPanel Grid.Row="3" LastChildFill="False" Margin="0,12,0,0"><TextBlock x:Name="TotalText" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Paste timecards" Click="Paste_Click"/><Button Content="Delete all" Foreground="#FFE07A78" Click="DeleteAll_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel></DockPanel>
  </Grid>
</Window>
