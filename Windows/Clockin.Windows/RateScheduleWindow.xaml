<Window x:Class="Clockin.Windows.RateScheduleWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Rate schedule" Width="680" Height="500" WindowStartupLocation="CenterOwner" Background="#0E1118" Foreground="#E8ECF4"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Button Content="Add rule" Click="Add_Click"/><TextBlock x:Name="Status" Foreground="#FF7A18" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel><ListView x:Name="Rules" Grid.Row="1" Margin="0,12"><ListView.View><GridView><GridViewColumn Header="From" DisplayMemberBinding="{Binding EffectiveFrom, StringFormat=yyyy-MM-dd}" Width="130"/><GridViewColumn Header="Until" DisplayMemberBinding="{Binding EffectiveUntil, StringFormat=yyyy-MM-dd}" Width="130"/><GridViewColumn Header="Hourly rate" DisplayMemberBinding="{Binding HourlyRate, StringFormat={}{0:0.##}}" Width="110"/><GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="240"/></GridView></ListView.View></ListView><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Delete selected" Click="Delete_Click"/><Button Content="Close" Click="Close_Click"/></StackPanel></Grid></Window>
