<Window x:Class="Clockin.Windows.CsvPreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CSV preview" Width="760" Height="580" WindowStartupLocation="CenterOwner" WindowStyle="None" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextBrush}"><Border BorderBrush="{DynamicResource CardStrokeBrush}" BorderThickness="1" CornerRadius="14"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Grid.Row="0" LastChildFill="False" Background="{DynamicResource CardBrush}" MouseLeftButtonDown="DragWindow"><TextBlock Text="CSV IMPORT PREVIEW" FontSize="12" FontWeight="Black" Margin="16,0" VerticalAlignment="Center"/><Button Width="34" Height="32" FontSize="16" FontWeight="SemiBold" Padding="0" Content="×" DockPanel.Dock="Right" Click="Close_Click" Margin="0,0,8,0"/></DockPanel><Grid Grid.Row="1" Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Summary" FontSize="11" Foreground="{DynamicResource AccentBrush}"/><ListView x:Name="Rows" Grid.Row="1" Margin="0,10"><ListView.View><GridView><GridViewColumn Header="Match" DisplayMemberBinding="{Binding KindText}" Width="85"/><GridViewColumn Header="Start" DisplayMemberBinding="{Binding StartText}" Width="170"/><GridViewColumn Header="End" DisplayMemberBinding="{Binding EndText}" Width="90"/><GridViewColumn Header="Duration" DisplayMemberBinding="{Binding DurationText}" Width="100"/><GridViewColumn Header="Source" DisplayMemberBinding="{Binding SourceText}" Width="150"/></GridView></ListView.View></ListView><TextBlock x:Name="Issues" Grid.Row="2" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Grid><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12"><Button Content="Cancel" Click="Close_Click"/><Button x:Name="ImportButton" Content="Import these entries" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource ActionForegroundBrush}" FontWeight="Bold" Click="Import_Click"/></StackPanel></Grid></Border></Window>
